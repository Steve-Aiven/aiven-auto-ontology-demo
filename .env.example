# Aiven project: shutchinson-demo
# Copy to .env and fill in values from the Aiven Console / AI Gateway tab.

# --- Aiven AI Gateway (chat / NL-to-SQL) ---
AIVEN_AI_GATEWAY_API_KEY=
DEFAULT_MODELS_API_KEY=${AIVEN_AI_GATEWAY_API_KEY}
DEFAULT_MODELS_ENDPOINT=https://ai.aiven.io/v1
DEFAULT_MODELS_MODEL=nemotron-nano-3-30b

REASONING_API_KEY=${AIVEN_AI_GATEWAY_API_KEY}
REASONING_ENDPOINT=https://ai.aiven.io/v1
REASONING_MODEL=nemotron-nano-3-30b

NON_REASONING_API_KEY=${AIVEN_AI_GATEWAY_API_KEY}
NON_REASONING_ENDPOINT=https://ai.aiven.io/v1
NON_REASONING_MODEL=nemotron-nano-9b-v2

# --- Embeddings via os-embed-shim -> OpenSearch ML Commons ---
# Do not point EMBED_* at the chat model.
EMBED_API_KEY=unused
EMBED_ENDPOINT=http://os-embed-shim:8080/v1
EMBED_MODEL=os-embed

# Rerank: disabled for v1 (OS cross-encoder API shape differs). Leave blank.
# RERANK_ENDPOINT=
# RERANK_MODEL=
# RERANK_API_KEY=

# --- Auto Ontology app ---
APP_URL=http://localhost:3000
AUTO_ONTOLOGY_MCP_PUBLIC_URL=http://localhost:3003
AUTH_SECRET=change-me-to-a-long-random-secret
AUTO_ONTOLOGY_ADMIN_EMAIL=admin@example.com
AUTO_ONTOLOGY_ADMIN_PASSWORD=autoontologypassword123
PYTHON_API_URL=http://auto-ontology:3001
INGESTION_SERVICE_URL=http://ingestion-service:3002

# --- Postgres (ontology store; Aiven Runtime injects these when integrated) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=avnadmin
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=defaultdb
POSTGRES_SSLMODE=require

# SaaS analytics source (same service, separate database after seed)
CONNECTION_STRINGS=postgresql://avnadmin:change-me@postgres:5432/saas_analytics?sslmode=require

# --- OpenSearch (os-embed-shim) ---
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USER=avnadmin
OPENSEARCH_PASSWORD=change-me
OPENSEARCH_SSL_VERIFY=false
OS_EMBED_MODEL_ID=
OS_EMBED_DIMS=384

# Local compose host port for Postgres if 5432 is taken
POSTGRES_HOST_PORT=5432
